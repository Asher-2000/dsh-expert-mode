# 排除node_modules
node_modules/

# 排除DSH配置目录
.dsh/

# 排除临时文件
*.tmp
*.temp
*.bak
*.bak.*

# 排除日志文件
*.log

# 排除Python缓存
__pycache__/
*.pyc

# 排除系统文件
.DS_Store
Thumbs.db

# 排除敏感信息
*.credentials
*.secret

# 排除会话数据
sessions/

# 排除存储数据
storages/

# 排除附件
attachments/

# 排除其他插件的node_modules
dsh-ui-plugins/*/node_modules/

# 排除构建产物
dsh-ui-plugins/*/dist/

# 排除专家模式消息总线运行期产物（bus.py 动态生成，非源码）
.expert-mode/comm/.seq
.expert-mode/comm/archive/
.expert-mode/comm/mailboxes/
.expert-mode/comm/logs/
# 任务调度器运行期产物（taskboard.py 动态生成，非源码）
.expert-mode/comm/tasks/
.expert-mode/comm/tasks_done/